{
  "name": "space-ghost",
  "description": "A minimalist, space-themed Ghost theme for space-ghost.org",
  "demo": "https://space-ghost.org",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "screenshots": {
    "desktop": "assets/images/screenshot-desktop.jpg",
    "mobile": "assets/images/screenshot-mobile.jpg"
  },
  "author": {
    "name": "Space Ghost",
    "email": "hello@space-ghost.org",
    "url": "https://space-ghost.org"
  },
  "keywords": [
    "ghost",
    "theme",
    "minimal",
    "space",
    "blog",
    "responsive"
  ],
  "config": {
    "posts_per_page": 10,
    "image_sizes": {
      "xs": {
        "width": 150
      },
      "s": {
        "width": 400
      },
      "m": {
        "width": 750
      },
      "l": {
        "width": 960
      },
      "xl": {
        "width": 1200
      }
    },
    "card_assets": true,
    "custom": {
      "navigation_layout": {
        "type": "select",
        "options": ["Logo on the left", "Logo in the middle"],
        "default": "Logo on the left"
      },
      "show_publication_cover": {
        "type": "boolean",
        "default": true,
        "group": "homepage"
      },
      "color_scheme": {
        "type": "select",
        "options": ["Auto", "Dark", "Light"],
        "default": "Auto"
      }
    }
  }
}